{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "klippy-web",
	"main": "app/worker.ts",
	"compatibility_date": "2026-11-03",
	"observability": { "enabled": true },
	// Files in public/ (the stylesheet, later the island bundles) are served by Cloudflare before the Worker runs.
	"assets": { "directory": "public" },
	// Bundle the islands into public/assets before every `wrangler dev` and `wrangler deploy`.
	"build": { "command": "pnpm build:client" },
	// AGENT is the agent Worker ("klippy"), called like fetch() but Worker to Worker: no public internet in between.
	"services": [{ "binding": "AGENT", "service": "klippy" }],
	// The same D1 database as the agent: the notes Klippy saves are the notes you see here.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "klippy-db",
			"database_id": "e51fc5ce-ea1d-48b0-afd7-e0af5cd1672f",
			"migrations_dir": "../../packages/db/migrations"
		}
	],
	// /klippy/check is public: at most 10 calls a minute per address. (namespace_id: any number unique in your account.)
	"ratelimits": [
		{ "name": "CHECK_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
		// Signed-in routes that reach your agent: at most 30 a minute per GitHub account (f-03). Keyed by who you are, not
		// your address: many people can share one address, and one person can have many.
		{ "name": "USER_LIMITER", "namespace_id": "1003", "simple": { "limit": 30, "period": 60 } }
	],
	"vars": {
		// Your deployed web app's address (GitHub sends you back here). .dev.vars sets http://localhost:8802 locally.
		"APP_ORIGIN": "https://klippy-web.YOUR-SUBDOMAIN.workers.dev",
		// The GitHub account ids allowed in, comma-separated (`gh api user --jq .id`). Klippy is personal: put only yours.
		"ALLOWED_GITHUB_IDS": "your-github-id"
	},
	// Set each with `wrangler secret put <NAME>`, and locally in .dev.vars. Never in this file.
	"secrets": { "required": ["GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "SESSION_SECRET", "KLIPPY_TOKEN"] },

	// f-07 Your own domain. Uncomment with a hostname on a zone in your Cloudflare account; Cloudflare creates the DNS
	// record and the certificate. Then set APP_ORIGIN above to https://<that hostname>, and add
	// https://<that hostname>/auth/github/callback to your GitHub OAuth app. (A route also turns off workers.dev, unless
	// you set "workers_dev": true.)
	// "routes": [{ "pattern": "klippy.example.com", "custom_domain": true }],

	// f-07 Previews: `wrangler preview` (or the CI job on a pull request) uploads this branch as a separate Preview with its
	// own URL. Previews don't inherit production settings: they get only what's in this block. A Preview is for looking at
	// the pages, never your data, so it gets no AGENT and no DB binding (a Preview's service binding would call your
	// PRODUCTION agent), and nobody is allowed to sign in. Its secrets are its own: set the four above once with
	// `wrangler preview base-config secret put <NAME>`, each a NEW value, never production's.
	"previews": {
		"vars": { "APP_ORIGIN": "https://preview.invalid", "ALLOWED_GITHUB_IDS": "" },
		"ratelimits": [
			{ "name": "CHECK_LIMITER", "namespace_id": "3002", "simple": { "limit": 10, "period": 60 } },
			{ "name": "USER_LIMITER", "namespace_id": "3003", "simple": { "limit": 30, "period": 60 } }
		]
	}
}
